# Copy to .env; these values are examples, not secrets.
DATASET_NAME=video_games_metadata
DATASET_VERSION=v1
HDFS_UI_PORT=9870
JUPYTER_PORT=8888
SPARK_UI_PORT=4040
FLUME_MEMORY_LIMIT=1g
SPARK_MEMORY_LIMIT=4g
SPARK_DRIVER_MEMORY=2g
SPARK_CPUS=2
# Keep the actual names of the existing HDFS volumes when migrating.
NAMENODE_VOLUME=hadoop-demo_namenode_data
DATANODE_VOLUME=hadoop-demo_datanode_data
FLUME_VOLUME=hadoop-demo_flume_state
